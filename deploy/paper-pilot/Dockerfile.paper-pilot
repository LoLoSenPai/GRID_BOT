FROM node:22-bookworm-slim

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable

WORKDIR /app

# Copy manifests first so dependency installation remains cacheable. The web
# manifest is needed because pnpm resolves every workspace importer in the
# lockfile, although the paper pilot does not run the web application.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/common/package.json packages/common/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/db/package.json packages/db/package.json
RUN pnpm install --frozen-lockfile

# Keep the image scope explicit: no root .env, production compose files,
# wallet material, audit history, or unrelated applications are copied.
COPY apps/worker apps/worker
COPY packages/common packages/common
COPY packages/core packages/core
COPY packages/db packages/db
COPY deploy/paper-pilot/config.json /app/config/sol-paper-pilot-config.json

RUN pnpm db:generate
RUN pnpm --filter @grid-bot/common build
RUN pnpm --filter @grid-bot/core build
RUN pnpm --filter @grid-bot/db build
RUN pnpm --filter @grid-bot/worker build

CMD ["node", "/app/apps/worker/node_modules/tsx/dist/cli.mjs", "apps/worker/scripts/observe-paper-pilot.mts", "5432", "/app/config/sol-paper-pilot-config.json", "86400", "/app/output"]
