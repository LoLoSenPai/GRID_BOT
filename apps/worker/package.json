{
  "name": "@grid-bot/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "shadow:start": "tsx src/shadow-jev-main.ts",
    "shadow:data": "tsx src/shadow-data-main.ts",
    "shadow:capture": "tsx src/shadow-capture-main.ts",
    "shadow:replay:v4": "tsx src/shadow-jev-v4-replay-main.ts",
    "shadow:costs": "tsx src/shadow-cost-audit-main.ts",
    "shadow:replay:v3": "tsx src/shadow-jev-v3-replay-main.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@grid-bot/common": "workspace:*",
    "@grid-bot/core": "workspace:*",
    "@grid-bot/db": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "vitest": "^4.0.8"
  }
}
